# Скопируй в .env для локального запуска: cp .env.example .env

# --- Claude (нужен для откликов / фазы 2) -----------------------------------
# Получить: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Модель Claude (по умолчанию claude-opus-4-8). Для экономии — claude-sonnet-4-6.
JOBBOT_MODEL=claude-opus-4-8

# Минимальный балл соответствия (0..100), ниже которого вакансия не попадает в подборку.
JOBBOT_MIN_SCORE=25

# --- Telegram-бот (интерактивный режим) -------------------------------------
# Токен от @BotFather (обязательно для бота).
TELEGRAM_BOT_TOKEN=
# Разрешённые chat_id через запятую. Если задано — бот реагирует только на них
# (рекомендуется). Если пусто — доверяет первому, кто напишет /start.
# Свой chat_id бот покажет в ответ на /start.
TELEGRAM_CHAT_ID=
# Авто-подборка по будням (true/false) и час по UTC (6 ≈ 11:00 Ташкент).
JOBBOT_AUTO_SEARCH=true
JOBBOT_DAILY_HOUR_UTC=6

# --- Figma export (PDF + PPTX) -----------------------------------------------
# Personal access token: https://www.figma.com/developers/api#access-tokens
FIGMA_TOKEN=

# --- Pitchdeck web export (хостинг презентаций из плагина Figma) ------------
# Секрет, которым плагин авторизуется при публикации (заголовок X-API-Token).
# Придумай длинную случайную строку.
PITCHDECK_API_TOKEN=
# Каталог для pitchdeck.db (SQLite: презентации + аналитика). На Railway —
# путь к примонтированному Volume.
PITCHDECK_DATA_DIR=
# Публичный домен сервиса, если автоопределение по запросу даёт не то (прокси,
# кастомный домен). Например: https://pitchdeck.mydomain.com
PITCHDECK_BASE_URL=

# --- Дизайнер (python -m designer, /design в Telegram) ----------------------
# Модель и глубина размышлений для генерации макетов.
DESIGNER_MODEL=claude-opus-5-5
DESIGNER_EFFORT=high
# 21st.dev — референсы компонентов (необязательно). Тот же ключ читает .mcp.json.
API_KEY_21ST=
# Сколько компонентов 21st брать на один дизайн (free-тариф: 2 в день).
DESIGNER_21ST_RETRIEVALS=1

# --- Видео LTX-2.5 (python -m designer video, /video в Telegram) -------------
# Ключ: https://console.ltx.io → API Keys (предоплаченные кредиты).
LTXV_API_KEY=
# Умолчания: модель fast|pro, разрешение 720p|1080p|1440p|4k, длительность в секундах или auto.
LTX_MODEL=fast
LTX_RESOLUTION=1080p
LTX_DURATION=6
# Потолок цены одного ролика в долларах.
LTX_MAX_USD=5

# --- Хранилище состояния -----------------------------------------------------
# Каталог для seen.json / shortlist.json / подписчиков. На Railway укажи путь
# к примонтированному Volume, чтобы данные не терялись между перезапусками.
JOBBOT_DATA_DIR=
